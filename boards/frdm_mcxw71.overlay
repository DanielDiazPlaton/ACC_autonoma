#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    aliases {
        motor-in1 = &motor_in1;
        motor-in2 = &motor_in2;
    };

    motor_gpios {
        compatible = "gpio-leds";

        motor_in1: motor_in1 {
            gpios = <&gpioc 1 GPIO_ACTIVE_HIGH>;
        };

        motor_in2: motor_in2 {
            gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
        };
    };
};