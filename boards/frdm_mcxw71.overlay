#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    aliases {
        motor-in1 = &motor_in1;
        motor-in2 = &motor_in2;

        servo-izquierdo = &servo_izquierdo;
        servo-derecho = &servo_derecho;

        acc-btn = &acc_toggle_button;

        /* Alias nuevo para el LiDAR TF-Luna */
        lidar-uart = &lpuart0;
    };

    /* Nodos nuevos para JSN-SR04T, botón de ignición y relevador 12V */
    zephyr,user {
        us-trig-gpios   = <&gpiob 5 GPIO_ACTIVE_HIGH>;
        us-echo-gpios   = <&gpiob 4 GPIO_ACTIVE_HIGH>;
        ign-btn-gpios   = <&gpiod 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
        obd-relay-gpios = <&gpiod 3 GPIO_ACTIVE_HIGH>;
    };

    motor_gpios {
        compatible = "gpio-leds";

        motor_in1: motor_in1 {
            gpios = <&gpioc 1 GPIO_ACTIVE_HIGH>;
        };

        motor_in2: motor_in2 {
            gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
        };
    };

    servos_prueba {
        compatible = "pwm-leds";

        servo_izquierdo: servo_izquierdo {
            pwms = <&tpm0 1 20000000 0>;
        };

        servo_derecho: servo_derecho {
            pwms = <&tpm0 2 20000000 0>;
        };
    };

    acc_user_buttons {
        compatible = "gpio-keys";
        acc_toggle_button: button_acc_on_off {
            gpios = <&gpiod 1 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "ACC Power Toggle Button PTD1";
        };
    };
};

&pinctrl {
    pinmux_lpuart0_lidar: pinmux_lpuart0_lidar {
        group0 {
            pinmux = <LPUART0_RX_PTA16>,
                     <LPUART0_TX_PTA17>;
            slew-rate = "slow";
            drive-strength = "low";
        };
    };
};

&lpuart0 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&pinmux_lpuart0_lidar>;
    pinctrl-names = "default";
};

&gpiob {
    status = "okay";
};

&gpiod {
    status = "okay";
};